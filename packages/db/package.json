{
  "name": "@o-radar/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "test:github": "tsx ../../scripts/test-github-scraper.ts",
    "test:rss": "tsx ../../scripts/test-rss-scraper.ts",
    "build": "prisma generate && tsc --noEmit",
    "check-types": "tsc --noEmit"
  },
  "dependencies": {
    "@prisma/client": "^6.19.0",
    "dotenv": "^16.4.7",
    "fast-xml-parser": "^5.2.5"
  },
  "devDependencies": {
    "@types/node": "26.4.1",
    "@repo/typescript-config": "workspace:*",
    "prisma": "^6.19.0",
    "tsx": "^4.19.3",
    "typescript": "7.0.2"
  }
}