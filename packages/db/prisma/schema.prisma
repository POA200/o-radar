datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id                 String    @id @default(cuid())
  name               String?
  email              String?   @unique
  emailVerified      DateTime?
  image              String?
  niche              String?
  targetRoles        String[]  @default([])
  targetChains      String[]  @default([])
  skills             String[]  @default([])
  cvText             String?   @db.Text
  portfolioUrl       String?
  githubUrl          String?
  onboardingComplete Boolean   @default(false)
  leads              Lead[]
  listingLeads       ListingLead[]
  accounts           Account[]
  sessions           Session[]
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
  @@index([userId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

enum LeadStatus {
  DISCOVERED
  RESEARCHING
  QUALIFIED
  READY_TO_CONTACT
  CONTACTED
  REPLIED
  APPLIED
  IN_PROGRESS
  WON
  LOST
  CONVERTED
  ARCHIVED
}

enum OpportunitySource {
  GITHUB_ISSUE
  GITHUB_DISCUSSION
  ECOSYSTEM_FORUM
  RSS_FEED
  CUSTOM_SCRAPER
}

enum OpportunityCategory {
  JOB
  BOUNTY
  GRANT
  HACKATHON
  CONTRIBUTOR_REQUEST
  SIGNAL
}

enum OpportunityConfidence {
  CONFIRMED
  SPECULATIVE
  STALE
}

model Project {
  id             String        @id @default(cuid())
  name           String
  description    String?
  targetKeywords String[]      @default([])
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  opportunities  Opportunity[]
}

model Opportunity {
  id              String                 @id @default(cuid())
  projectId       String?
  project         Project?               @relation(fields: [projectId], references: [id], onDelete: SetNull)
  source          OpportunitySource
  nativeId        String
  hash            String                 @unique
  category        OpportunityCategory    @default(SIGNAL)
  confidence      OpportunityConfidence  @default(SPECULATIVE)
  sourceQuality   Int                    @default(0)
  title           String
  url             String
  content         String                 @db.Text
  score           Int                    @default(0)
  publishedAt     DateTime?
  discoveredAt    DateTime               @default(now())
  expiresAt       DateTime?
  isStale         Boolean                @default(false)
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
  evidences       Evidence[]
  leads           Lead[]

  @@index([source, nativeId])
  @@index([category, isStale, publishedAt])
  @@index([discoveredAt])
}

model Evidence {
  id            String      @id @default(cuid())
  opportunityId String
  opportunity   Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  type          String
  rawPayload    Json
  capturedAt    DateTime    @default(now())
}

model SourceHealth {
  id              String            @id @default(cuid())
  source          OpportunitySource @unique
  lastSuccessAt   DateTime?
  lastAttemptAt   DateTime?
  lastError       String?           @db.Text
  fetchedCount    Int               @default(0)
  createdCount    Int               @default(0)
  updatedCount    Int               @default(0)
  skippedCount    Int               @default(0)
  failedCount     Int               @default(0)
  updatedAt       DateTime          @updatedAt
}

model Lead {
  id            String      @id @default(cuid())
  userId        String?
  user          User?       @relation(fields: [userId], references: [id], onDelete: Cascade)
  opportunityId String
  opportunity   Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  handle        String
  platform      String
  profileUrl    String?
  contactEmail  String?
  status        LeadStatus  @default(DISCOVERED)
  notes         String?     @db.Text
  priority      Int         @default(0)
  savedAt       DateTime    @default(now())
  lastContactedAt DateTime?
  appliedAt       DateTime?
  nextFollowUpAt DateTime?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@unique([userId, opportunityId, platform, handle])
  @@index([userId, status])
}


enum ListingDiscoverySource {
  DEX_SCREENER
  COIN_GECKO
  COIN_MARKET_CAP
  LAUNCHPAD
  GECKO_TERMINAL
  MANUAL
  OTHER
}

enum ListingLeadStatus {
  DISCOVERED
  RESEARCHING
  QUALIFIED
  CONTACTED
  REPLIED
  IN_PROGRESS
  WON
  LOST
  CONVERTED
  ARCHIVED
}

model ListingLead {
  id               String                 @id @default(cuid())
  userId           String?
  user             User?                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectName      String
  tokenSymbol      String?
  chain            String?
  contractAddress  String?
  websiteUrl       String?
  xUrl             String?
  telegramUrl      String?
  discordUrl       String?
  discoverySource  ListingDiscoverySource  @default(MANUAL)
  sourceUrl        String?
  volume24hUsd     Float?
  holderCount      Int?
  listingStatus    ListingLeadStatus      @default(DISCOVERED)
  priority         Int                    @default(0)
  contactName      String?
  contactEmail     String?
  contactTelegram  String?
  notes            String?                @db.Text
  lastContactedAt  DateTime?
  nextFollowUpAt   DateTime?
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt

  @@unique([userId, chain, contractAddress])
  @@index([userId])
  @@index([listingStatus])
  @@index([chain])
  @@index([priority])
  @@index([createdAt])
}
